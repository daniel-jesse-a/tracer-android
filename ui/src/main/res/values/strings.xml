    <!-- onboarding -->
    <string name="onboarding_title">Set up Tracer</string>
    <string name="onboarding_intro">Tracer logs radio, Wi-Fi, GNSS and network quality on the move. Each permission below feeds one part of the log; nothing leaves the phone unless you export it.</string>
    <string name="onboarding_allow">Allow</string>
    <string name="onboarding_allow_all_time">Allow all the time</string>
    <string name="onboarding_after_location">After location</string>
    <string name="onboarding_continue">Continue</string>
    <string name="onboarding_required_hint">Precise location and phone state are required to record a run.</string>
    <string name="onboarding_camera_note">Camera access is requested only when you scan a companion QR code.</string>
    <string name="perm_location">Precise location</string>
    <string name="perm_location_why">Positions every sample on the map. Android also requires it to read cell info and Wi-Fi scan results.</string>
    <string name="perm_background">Location · Allow all the time</string>
    <string name="perm_background_why">Keeps recording when the screen is off or another app is open. Android opens its settings page: choose “Allow all the time”, then come back.</string>
    <string name="perm_phone">Phone state</string>
    <string name="perm_phone_why">Reads active SIMs, 5G NR state and per-SIM radio technology. No calls or call logs are accessed.</string>
    <string name="perm_nearby_wifi">Nearby Wi-Fi devices</string>
    <string name="perm_nearby_wifi_why">Needed for Wi-Fi scans and access-point details. Scan results are used for location context, so this is not a “never for location” grant.</string>
    <string name="perm_activity">Physical activity</string>
    <string name="perm_activity_why">Tags samples as still, walking or in vehicle, so drops can be read against movement.</string>
    <string name="perm_notifications">Notifications</string>
    <string name="perm_notifications_why">Shows the live recording notification with Pause / End and alerts when a run stops by itself.</string>
    <string name="perm_battery">Battery optimisation exemption</string>
    <string name="perm_battery_why">Stops Android from throttling or killing a long recording. On Samsung also add Tracer to Settings › Battery › Background usage limits › Never sleeping apps.</string>

